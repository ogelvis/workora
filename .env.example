DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DBNAME?sslmode=require
SESSION_SECRET=REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_SECRET
NODE_ENV=development
PORT=3001
SESSION_TTL_DAYS=7
# Secret address of the owner's console sign-in (e.g. MaryNgaji). Leave unset to disable the console.
ADMIN_PATH=
# Comma-separated emails allowed to sign in to the console
PLATFORM_ADMIN_EMAILS=you@example.com
# Where customers send plan upgrade requests (shown on the Billing page)
SUPPORT_EMAIL=billing@example.com
# Outgoing email (partner welcome links). Use EITHER Resend OR SMTP.
EMAIL_FROM=OVO <hello@yourdomain.com>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
